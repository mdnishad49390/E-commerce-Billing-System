# Django Configuration
SECRET_KEY=django-insecure-billing-super-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Set DB_ENGINE=postgresql for Postgres, or sqlite for SQLite)
DB_ENGINE=sqlite
DB_NAME=billing_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email / SMTP Configuration
# For production Gmail: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Use a 16-character Google App Password (not your normal Google account password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-company@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=your-company@gmail.com
ADMIN_EMAIL=admin@your-company.com

# WhatsApp Cloud API Configuration (Meta Graph API)
# Get from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional custom gateway URL (leave blank to use official Graph API v21.0)
WHATSAPP_API_URL=
